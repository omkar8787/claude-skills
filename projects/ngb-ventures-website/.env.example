# ── Site ─────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://www.your-domain.com

# ── Public contact details (leave blank to hide) ─────
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_CONTACT_PHONE=
# Digits only incl. country code, e.g. 9198XXXXXXXX. Enables WhatsApp buttons.
NEXT_PUBLIC_WHATSAPP_NUMBER=
NEXT_PUBLIC_LINKEDIN_URL=
NEXT_PUBLIC_INSTAGRAM_URL=
NEXT_PUBLIC_YOUTUBE_URL=

# ── Enquiry delivery (configure at least ONE in production) ──
# Option A: email via Resend (https://resend.com). FROM must be on a verified domain.
RESEND_API_KEY=
ENQUIRY_TO_EMAIL=
ENQUIRY_FROM_EMAIL=
# Option B: webhook (Zapier / Make / n8n / CRM). Body is JSON; X-NGB-Signature = HMAC-SHA256(body, secret).
ENQUIRY_WEBHOOK_URL=
ENQUIRY_WEBHOOK_SECRET=
# Option C (development only): append to .data/enquiries.jsonl
ENQUIRY_FILE_SINK=false

# ── Optional spam protection: Cloudflare Turnstile ───
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ── Show factual placeholders in production builds (default hidden) ──
NEXT_PUBLIC_SHOW_PLACEHOLDERS=false
